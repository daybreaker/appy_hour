source "https://rubygems.org"

gem "rails", "~> 8.1.3"
gem "propshaft"
gem "puma", ">= 5.0"
gem "bootsnap", require: false
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Database / PostGIS
gem "pg"
gem "activerecord-postgis-adapter"
gem "rgeo"
gem "geocoder"              # address → lat/lng when creating venues

# Hotwire / Frontend
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "tailwindcss-rails"

# Auth & Authorization
gem "devise"
gem "cancancan"

# Background Jobs (Solid Queue replaced by Sidekiq)
gem "sidekiq"
gem "sidekiq-cron"          # cron scheduling for scraper runs
gem "redis"
gem "solid_cache"           # DB-backed cache (no Redis needed for cache)
gem "solid_cable"           # DB-backed ActionCable

# API
gem "rack-cors"             # CORS for Expo mobile app
gem "rack-attack"           # rate limiting on api/v1
gem "blueprinter"           # serializers for api/v1 JSON responses

# Scraper
gem "faraday"
gem "faraday-retry"
gem "faraday-follow_redirects"   # follow http->https and other 3xx when scraping
gem "pdf-reader"                 # extract text from PDF menus
gem "ferrum"                     # headless Chrome for JS-rendered sites
gem "anthropic"             # Claude API for LLM-assisted menu parsing

# Search / Pagination
gem "pg_search"             # PostgreSQL full-text search
gem "pagy"                  # pagination

# Notifications
gem "noticed"               # multi-channel: email now, SMS + push later

# Soft Deletes
gem "discard"               # discarded_at column, cleaner than paranoia

# Infrastructure
gem "image_processing", "~> 1.2"
gem "kamal", require: false
gem "thruster", require: false

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "bundler-audit", require: false
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false

  # Testing
  gem "rspec-rails"
  gem "factory_bot_rails"
  gem "faker"
  gem "shoulda-matchers"
  gem "webmock"             # stub all outbound HTTP (Google Places, Claude, scraped sites)
end

group :development do
  gem "web-console"
  gem "dotenv-rails"        # loads .env into ENV for the server, console, and Sidekiq
end

group :test do
  gem "capybara"
end
