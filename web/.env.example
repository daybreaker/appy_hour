# Copy this file to .env and fill in real values. .env is gitignored.
# dotenv-rails loads these into ENV for the Rails server, console, and Sidekiq.

# Anthropic — Claude menu extraction (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Google Places API (New) — venue discovery
# console.cloud.google.com → enable "Places API (New)" → Credentials → API Key
GOOGLE_PLACES_API_KEY=

# Sidekiq / Redis (optional — defaults to redis://localhost:6379/0)
# REDIS_URL=redis://localhost:6379/0
