<%# locals: venue, day_of_week (optional — highlights that day's times) %>
<% day_of_week = local_assigns[:day_of_week] %>
<%= link_to venue_path(venue), class: "block bg-white rounded-lg border border-gray-200 hover:border-amber-400 hover:shadow-sm transition p-5" do %>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-gray-900">
      <% if favorited?(venue) %><span class="text-amber-500" title="Favorite">★</span> <% end %><%= venue.name %>
    </h3>
    <% if venue.neighborhood %>
      <span class="text-xs text-gray-400 whitespace-nowrap"><%= venue.neighborhood.name %></span>
    <% end %>
  </div>
  <p class="text-sm text-gray-500 mt-0.5"><%= venue.address %></p>

  <% if day_of_week %>
    <% days = venue.happy_hours.approved.flat_map(&:happy_hour_days).select { |d| d.day_of_week == day_of_week } %>
    <% if days.any? %>
      <div class="mt-3 space-y-1">
        <% days.each do |day| %>
          <div class="text-sm text-amber-700 font-medium">
            <%= day.hours_label %>
            <%= day.happy_hour&.notes %><% if day.note.present? %><span class="text-gray-400 font-normal italic"> — <%= day.note %></span><% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
