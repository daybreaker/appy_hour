<%# locals: f (fields_for builder) %>
<div class="day-fields border border-gray-200 rounded-lg p-4 flex flex-wrap items-end gap-3"
     data-nested-form-target="row" data-controller="all-day">
  <div>
    <label class="block text-xs font-medium text-gray-500 mb-1">Day</label>
    <%= f.select :day_of_week,
          options_for_select((0..6).map { |d| [ Date::DAYNAMES[d], d ] }, f.object.day_of_week),
          {},
          class: "border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-500 mb-1">Start</label>
    <%= f.time_field :start_time, data: { all_day_target: "time" },
          class: "border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-500 mb-1">End</label>
    <%= f.time_field :end_time, data: { all_day_target: "time" },
          class: "border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>
  <label class="flex items-center gap-1.5 text-sm text-gray-600 pb-2">
    <%= f.check_box :all_day, data: { all_day_target: "checkbox", action: "all-day#toggle" },
          class: "rounded border-gray-300 text-amber-500 focus:ring-amber-400" %>
    All day
  </label>
  <div class="flex-1 min-w-[10rem]">
    <label class="block text-xs font-medium text-gray-500 mb-1">Note <span class="text-gray-400">(optional)</span></label>
    <%= f.text_field :note, placeholder: "e.g. For service industry workers",
          class: "border border-gray-300 rounded px-3 py-2 text-sm w-full" %>
  </div>
  <%= f.hidden_field :_destroy, data: { nested_form_target: "destroyFlag" } %>
  <button type="button" data-action="nested-form#remove"
          class="px-2 py-2 text-sm text-red-500 hover:text-red-700">Remove</button>
</div>
