<div class="mb-6">
  <h1 class="text-3xl font-bold mb-1">Venues</h1>
  <p class="text-gray-500">Browse all bars and restaurants.</p>
</div>

<%= form_with url: venues_path, method: :get, class: "mb-6 flex flex-wrap items-center gap-2" do |f| %>
  <%= f.search_field :q, value: params[:q], placeholder: "Search by name…",
        class: "border border-gray-300 rounded px-3 py-2 text-sm w-64" %>
  <%= f.select :neighborhood_id,
        options_from_collection_for_select(@neighborhoods, :id, :name, params[:neighborhood_id]),
        { include_blank: "All neighborhoods" },
        class: "border border-gray-300 rounded px-3 py-2 text-sm" %>
  <%= f.submit "Search", class: "px-4 py-2 bg-amber-500 text-white rounded text-sm hover:bg-amber-600 cursor-pointer" %>
<% end %>

<% if @venues.empty? %>
  <div class="bg-white rounded-lg border border-gray-200 p-12 text-center text-gray-400">
    <p class="text-lg">No venues found.</p>
  </div>
<% else %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @venues.each do |venue| %>
      <%= render "venues/card", venue: venue %>
    <% end %>
  </div>
  <div class="mt-8 pagy"><%== @pagy.series_nav %></div>
<% end %>
