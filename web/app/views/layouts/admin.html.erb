<!DOCTYPE html>
<html>
  <head>
    <title>AppyHour Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 text-gray-900">
    <div class="flex min-h-screen">

      <%# Sidebar %>
      <aside class="w-56 bg-gray-900 text-gray-100 flex flex-col flex-shrink-0">
        <div class="px-4 py-5 border-b border-gray-700">
          <span class="font-bold text-lg">AppyHour</span>
          <span class="ml-1 text-xs text-gray-400 uppercase tracking-wide">Admin</span>
        </div>
        <nav class="flex-1 px-2 py-4 space-y-1">
          <%= link_to "Dashboard", admin_root_path,
                class: "flex items-center px-3 py-2 rounded text-sm hover:bg-gray-700 #{"bg-gray-700" if current_page?(admin_root_path)}" %>
          <%= link_to "Happy Hours", admin_happy_hours_path,
                class: "flex items-center px-3 py-2 rounded text-sm hover:bg-gray-700 #{"bg-gray-700" if request.path.start_with?(admin_happy_hours_path)}" %>
          <%= link_to "Venues", admin_venues_path,
                class: "flex items-center px-3 py-2 rounded text-sm hover:bg-gray-700 #{"bg-gray-700" if request.path.start_with?(admin_venues_path)}" %>
          <%= link_to "Neighborhoods", admin_neighborhoods_path,
                class: "flex items-center px-3 py-2 rounded text-sm hover:bg-gray-700 #{"bg-gray-700" if request.path.start_with?(admin_neighborhoods_path)}" %>
          <%= link_to "Comments", admin_comments_path,
                class: "flex items-center px-3 py-2 rounded text-sm hover:bg-gray-700 #{"bg-gray-700" if request.path.start_with?(admin_comments_path)}" %>
          <%= link_to "Reports", admin_reports_path,
                class: "flex items-center px-3 py-2 rounded text-sm hover:bg-gray-700 #{"bg-gray-700" if request.path.start_with?(admin_reports_path)}" %>
        </nav>
        <div class="px-4 py-4 border-t border-gray-700 text-xs text-gray-400">
          <%= current_user.email %>
          <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "block mt-1 hover:text-white" %>
        </div>
      </aside>

      <%# Main content %>
      <div class="flex-1 flex flex-col overflow-hidden">
        <% if notice.present? %>
          <div class="bg-green-50 border-b border-green-200 px-6 py-3 text-sm text-green-800">
            <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="bg-red-50 border-b border-red-200 px-6 py-3 text-sm text-red-800">
            <%= alert %>
          </div>
        <% end %>

        <main class="flex-1 overflow-auto p-8">
          <%= yield %>
        </main>
      </div>

    </div>
  </body>
</html>
