<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "AppyHour — Cleveland Happy Hours" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <%= link_to root_path, class: "flex items-center gap-2 font-bold text-xl text-amber-600" do %>
          🍻 AppyHour
        <% end %>
        <nav class="flex items-center gap-4 text-sm">
          <%= link_to "Browse", root_path, class: "text-gray-600 hover:text-gray-900" %>
          <%= link_to "Venues", venues_path, class: "text-gray-600 hover:text-gray-900" %>
          <% if user_signed_in? %>
            <%= link_to "★ Favorites", favorites_path, class: "text-gray-600 hover:text-gray-900" %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "text-gray-600 hover:text-gray-900" %>
            <% end %>
            <span class="text-gray-400"><%= current_user.email %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                  class: "text-gray-600 hover:text-gray-900" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-gray-600 hover:text-gray-900" %>
            <%= link_to "Sign up", new_user_registration_path,
                  class: "px-3 py-1.5 bg-amber-500 text-white rounded hover:bg-amber-600" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice.present? %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="bg-green-50 border border-green-200 text-green-800 rounded px-4 py-2 text-sm"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="bg-red-50 border border-red-200 text-red-800 rounded px-4 py-2 text-sm"><%= alert %></div>
      </div>
    <% end %>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
