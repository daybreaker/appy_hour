<div class="mb-6">
  <h1 class="text-3xl font-bold mb-1">Your Favorites</h1>
  <p class="text-gray-500">Venues you've starred.</p>
</div>

<% if @venues.empty? %>
  <div class="bg-white rounded-lg border border-gray-200 p-12 text-center text-gray-400">
    <p class="text-lg">No favorites yet.</p>
    <p class="text-sm mt-1">Tap the ☆ on any venue to save it here.</p>
    <%= link_to "Browse venues", venues_path, class: "inline-block mt-3 text-amber-600 hover:underline" %>
  </div>
<% else %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @venues.each do |venue| %>
      <%= render "venues/card", venue: venue %>
    <% end %>
  </div>
<% end %>
