<%# locals: happy_hour %>
<div class="border border-gray-200 rounded-lg p-5">
  <% if happy_hour.notes.present? %>
    <p class="text-gray-700 mb-3"><%= happy_hour.notes %></p>
  <% end %>

  <% happy_hour.happy_hour_days.sort_by { |d| [ d.specific_date ? 1 : 0, d.day_of_week || 0 ] }.each do |day| %>
    <div class="mb-4 last:mb-0">
      <div class="flex items-baseline gap-2 mb-2">
        <span class="font-semibold text-gray-900"><%= day.day_name %></span>
        <span class="text-sm text-amber-700 font-medium"><%= format_time_range(day.start_time, day.end_time) %></span>
      </div>

      <% deals = day.happy_hour_generics.select { |d| d.status == "approved" } +
                 day.happy_hour_items.select { |d| d.status == "approved" } +
                 day.happy_hour_bogos.select { |d| d.status == "approved" } %>

      <% if deals.any? %>
        <ul class="space-y-1 pl-1">
          <% day.happy_hour_generics.select { |d| d.status == "approved" }.each do |deal| %>
            <li class="text-sm text-gray-600 flex items-start gap-2">
              <span class="text-amber-500">•</span> <%= generic_deal_label(deal) %>
            </li>
          <% end %>
          <% day.happy_hour_items.select { |d| d.status == "approved" }.each do |item| %>
            <li class="text-sm text-gray-600 flex items-start gap-2">
              <span class="text-amber-500">•</span>
              <span>
                <%= item.name %> —
                <span class="font-medium text-gray-900">$<%= item.happy_hour_price.to_f.round(2) %></span>
                <% if item.original_price.present? %>
                  <span class="line-through text-gray-400 text-xs">$<%= item.original_price.to_f.round(2) %></span>
                <% end %>
              </span>
            </li>
          <% end %>
          <% day.happy_hour_bogos.select { |d| d.status == "approved" }.each do |bogo| %>
            <li class="text-sm text-gray-600 flex items-start gap-2">
              <span class="text-amber-500">•</span> <%= bogo_deal_label(bogo) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-gray-400 italic pl-1">Deals not itemized yet</p>
      <% end %>
    </div>
  <% end %>
</div>
