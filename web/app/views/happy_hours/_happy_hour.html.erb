<%# locals: happy_hour %>
<div class="border border-gray-200 rounded-lg p-5">
  <%# When this menu runs %>
  <div class="flex flex-wrap gap-x-4 gap-y-1 mb-3">
    <% happy_hour.happy_hour_days.sort_by { |d| [ d.specific_date ? 1 : 0, d.day_of_week || 0 ] }.each do |day| %>
      <span class="text-sm">
        <span class="font-semibold text-gray-900"><%= day.day_name %></span>
        <span class="text-amber-700 font-medium ml-1"><%= day.hours_label %></span>
      </span>
    <% end %>
  </div>

  <% if happy_hour.notes.present? %>
    <p class="text-gray-700 mb-3"><%= happy_hour.notes %></p>
  <% end %>

  <%# The menu — the same deals across all the days above %>
  <% generics = happy_hour.happy_hour_generics.select { |d| d.status == "approved" } %>
  <% items = happy_hour.happy_hour_items.select { |d| d.status == "approved" } %>
  <% bogos = happy_hour.happy_hour_bogos.select { |d| d.status == "approved" } %>

  <% if generics.any? || items.any? || bogos.any? %>
    <ul class="space-y-1 pl-1">
      <% generics.each do |deal| %>
        <li class="text-sm text-gray-600 flex items-start gap-2">
          <span class="text-amber-500">•</span> <%= generic_deal_label(deal) %>
        </li>
      <% end %>
      <% items.each do |item| %>
        <li class="text-sm text-gray-600 flex items-start gap-2">
          <span class="text-amber-500">•</span>
          <span>
            <%= item.name %> —
            <span class="font-medium text-gray-900">$<%= item.happy_hour_price.to_f.round(2) %></span>
            <% if item.original_price.present? %>
              <span class="line-through text-gray-400 text-xs">$<%= item.original_price.to_f.round(2) %></span>
            <% end %>
          </span>
        </li>
      <% end %>
      <% bogos.each do |bogo| %>
        <li class="text-sm text-gray-600 flex items-start gap-2">
          <span class="text-amber-500">•</span> <%= bogo_deal_label(bogo) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-400 italic pl-1">Deals not itemized yet</p>
  <% end %>

  <% if happy_hour.link.present? %>
    <div class="mt-4 pt-3 border-t border-gray-100">
      <%= link_to happy_hour.link, target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-1 text-sm text-amber-600 hover:text-amber-700 font-medium" do %>
        <%= happy_hour.specific_source? ? "View happy hour menu" : "Visit website" %> ↗
      <% end %>
    </div>
  <% end %>
</div>
