<%# locals: deal, day %>
<%= turbo_frame_tag "day_#{day.id}_bogo_form" do %>
  <%= form_with model: deal, url: admin_happy_hour_day_bogo_deals_path(day), class: "space-y-2" do |f| %>
    <% if deal.errors.any? %>
      <p class="text-xs text-red-600"><%= deal.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="flex flex-wrap items-end gap-2">
      <div>
        <label class="block text-xs text-gray-500">Buy</label>
        <%= f.number_field :buy_quantity, value: f.object.buy_quantity || 1, min: 1, class: "border rounded px-2 py-1 text-sm w-16" %>
      </div>
      <div>
        <label class="block text-xs text-gray-500">Get</label>
        <%= f.number_field :get_quantity, value: f.object.get_quantity || 1, min: 1, class: "border rounded px-2 py-1 text-sm w-16" %>
      </div>
      <div>
        <label class="block text-xs text-gray-500">Get deal</label>
        <%= f.select :get_discount_type, HappyHourBogo.get_discount_types.keys.map { |k| [ k.humanize, k ] },
              {}, class: "border rounded px-2 py-1 text-sm" %>
      </div>
      <div>
        <label class="block text-xs text-gray-500">Value</label>
        <%= f.number_field :get_discount_value, step: :any, placeholder: "if not free", class: "border rounded px-2 py-1 text-sm w-24" %>
      </div>
      <div>
        <label class="block text-xs text-gray-500">Applies to</label>
        <%= f.text_field :applies_to, placeholder: "e.g. wings", class: "border rounded px-2 py-1 text-sm w-28" %>
      </div>
      <div>
        <label class="block text-xs text-gray-500">Item name</label>
        <%= f.text_field :item_name, class: "border rounded px-2 py-1 text-sm w-28" %>
      </div>
      <%= f.submit "Add", class: "px-3 py-1 bg-amber-500 text-white text-sm rounded hover:bg-amber-600 cursor-pointer" %>
    </div>
  <% end %>
<% end %>
