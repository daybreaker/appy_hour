<%# locals: deal, happy_hour %>
<%= turbo_frame_tag "happy_hour_#{happy_hour.id}_bogo_form" do %>
  <%= form_with model: deal, url: admin_happy_hour_bogo_deals_path(happy_hour) do |f| %>
    <% if deal.errors.any? %>
      <p class="text-xs text-red-600 mb-1"><%= deal.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="flex flex-wrap items-end gap-2">
      <%= render "admin/deals/bogo_fields", f: f %>
      <%= f.submit "Add", class: "px-3 py-1 bg-amber-500 text-white text-sm rounded hover:bg-amber-600 cursor-pointer" %>
    </div>
  <% end %>
<% end %>
