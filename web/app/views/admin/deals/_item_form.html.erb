<%# locals: deal, happy_hour %>
<%= turbo_frame_tag "happy_hour_#{happy_hour.id}_item_form" do %>
  <%= form_with model: deal, url: admin_happy_hour_item_deals_path(happy_hour), class: "space-y-2" do |f| %>
    <% if deal.errors.any? %>
      <p class="text-xs text-red-600"><%= deal.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="flex flex-wrap items-end gap-2">
      <div>
        <label class="block text-xs text-gray-500">Name</label>
        <%= f.text_field :name, placeholder: "e.g. House Margarita", class: "border rounded px-2 py-1 text-sm w-36" %>
      </div>
      <div>
        <label class="block text-xs text-gray-500">Category</label>
        <%= f.select :category, [ [ "Food", "food" ], [ "Drink", "drink" ] ], { include_blank: "—" },
              class: "border rounded px-2 py-1 text-sm" %>
      </div>
      <div>
        <label class="block text-xs text-gray-500">Reg. price</label>
        <%= f.number_field :original_price, step: :any, class: "border rounded px-2 py-1 text-sm w-20" %>
      </div>
      <div>
        <label class="block text-xs text-gray-500">HH price</label>
        <%= f.number_field :happy_hour_price, step: :any, class: "border rounded px-2 py-1 text-sm w-20" %>
      </div>
    </div>
    <div class="flex items-end gap-2">
      <div class="flex-1">
        <label class="block text-xs text-gray-500">Description</label>
        <%= f.text_field :description, placeholder: "e.g. Handmade with fresh lime",
              class: "border rounded px-2 py-1 text-sm w-full" %>
      </div>
      <%= f.submit "Add", class: "px-3 py-1 bg-amber-500 text-white text-sm rounded hover:bg-amber-600 cursor-pointer" %>
    </div>
  <% end %>
<% end %>
