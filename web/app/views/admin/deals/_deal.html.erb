<%# locals: deal, happy_hour %>
<%= turbo_frame_tag dom_id(deal) do %>
  <div class="flex items-center justify-between gap-3 py-1.5 px-3 rounded bg-gray-50 text-sm">
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-xs uppercase tracking-wide text-gray-400 w-16 flex-shrink-0">
        <%= deal.is_a?(HappyHourBogo) ? "BOGO" : deal.model_name.human.sub("Happy hour ", "") %>
      </span>
      <span class="text-gray-700 truncate">
        <%= deal_summary(deal) %><% if deal.description.present? %><span class="text-gray-400"> — <%= deal.description %></span><% end %>
      </span>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <%= link_to "Edit", edit_admin_deal_path(happy_hour, deal), class: "text-amber-600 hover:text-amber-700 text-xs leading-none" %>
      <%= button_to admin_deal_path(happy_hour, deal), method: :delete,
            form: { class: "inline-flex", data: { turbo_confirm: "Remove this deal?" } },
            class: "text-red-500 hover:text-red-700 text-xs leading-none bg-transparent border-0 p-0 cursor-pointer" do %>
        Remove
      <% end %>
    </div>
  </div>
<% end %>
