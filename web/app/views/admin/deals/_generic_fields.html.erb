<%# locals: f %>
<div>
  <label class="block text-xs text-gray-500">Applies to</label>
  <%= f.text_field :applies_to, placeholder: "e.g. drafts", class: "border rounded px-2 py-1 text-sm w-32" %>
</div>
<div>
  <label class="block text-xs text-gray-500">Type</label>
  <%= f.select :discount_type, HappyHourGeneric.discount_types.keys.map { |k| [ k.humanize, k ] },
        {}, class: "border rounded px-2 py-1 text-sm" %>
</div>
<div>
  <label class="block text-xs text-gray-500">Value</label>
  <%= f.number_field :discount_value, step: :any, class: "border rounded px-2 py-1 text-sm w-20" %>
</div>
<div class="flex-1 min-w-[8rem]">
  <label class="block text-xs text-gray-500">Description</label>
  <%= f.text_field :description, class: "border rounded px-2 py-1 text-sm w-full" %>
</div>
