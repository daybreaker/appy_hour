<%# locals: happy_hour, day — inline edit form for one schedule day %>
<%= turbo_frame_tag dom_id(day) do %>
  <%= form_with model: day, url: admin_happy_hour_happy_hour_day_path(happy_hour, day), method: :patch,
        data: { controller: "all-day" }, class: "flex flex-wrap items-end gap-3 bg-amber-50 rounded p-2" do |f| %>
    <% if day.errors.any? %>
      <p class="w-full text-xs text-red-600"><%= day.errors.full_messages.to_sentence %></p>
    <% end %>
    <%= render "admin/happy_hours/schedule_fields", f: f %>
    <%= f.submit "Save", class: "px-3 py-2 bg-amber-500 text-white text-sm rounded hover:bg-amber-600 cursor-pointer" %>
    <%= link_to "Cancel", admin_happy_hour_happy_hour_day_path(happy_hour, day),
          class: "px-3 py-2 text-gray-500 hover:text-gray-700 text-sm" %>
  <% end %>
<% end %>
