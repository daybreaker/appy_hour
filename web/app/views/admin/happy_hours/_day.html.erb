<%# locals: day %>
<div id="<%= dom_id(day) %>" class="border border-gray-200 rounded-lg p-4">
  <div class="flex items-center justify-between mb-3">
    <h3 class="font-semibold text-gray-900">
      <%= day.day_name %>
      <span class="font-normal text-sm text-amber-700 ml-1"><%= format_time_range(day.start_time, day.end_time) %></span>
    </h3>
    <%= button_to admin_happy_hour_day_path(day), method: :delete,
          form: { data: { turbo_confirm: "Remove this day and its deals?" } },
          class: "text-xs text-red-500 hover:text-red-700" do %>
      Remove day
    <% end %>
  </div>

  <%# Existing deals %>
  <div id="day_<%= day.id %>_deals" class="space-y-1.5 mb-3">
    <% day.deals.each do |deal| %>
      <%= render "admin/deals/deal", deal: deal, day: day %>
    <% end %>
  </div>

  <%# Dynamic add-deal picker %>
  <div data-controller="deal-picker" class="border-t border-gray-100 pt-3">
    <div class="flex gap-2 mb-3">
      <% [ %w[Discount generic], %w[Item item], %w[BOGO bogo] ].each do |label, type| %>
        <button type="button"
                data-action="deal-picker#show"
                data-deal-picker-type-param="<%= type %>"
                data-deal-picker-target="tab"
                class="px-3 py-1 rounded text-sm bg-gray-100 text-gray-600 hover:bg-gray-200">
          + <%= label %>
        </button>
      <% end %>
    </div>

    <div data-deal-picker-target="form" data-type="generic" class="hidden">
      <%= render "admin/deals/generic_form", deal: day.happy_hour_generics.new, day: day %>
    </div>
    <div data-deal-picker-target="form" data-type="item" class="hidden">
      <%= render "admin/deals/item_form", deal: day.happy_hour_items.new, day: day %>
    </div>
    <div data-deal-picker-target="form" data-type="bogo" class="hidden">
      <%= render "admin/deals/bogo_form", deal: day.happy_hour_bogos.new, day: day %>
    </div>
  </div>
</div>
