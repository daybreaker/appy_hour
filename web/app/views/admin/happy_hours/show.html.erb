<div class="mb-6">
  <%= link_to "← Back to queue", admin_happy_hours_path, class: "text-sm text-gray-400 hover:text-gray-600" %>
</div>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold"><%= @happy_hour.venue.name %></h1>
      <p class="text-gray-500 text-sm"><%= @happy_hour.venue.address %></p>
      <span class="inline-flex items-center mt-2 px-2 py-0.5 rounded text-xs font-medium
        <%= @happy_hour.approved? ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800" %>">
        <%= @happy_hour.status.humanize %>
      </span>
      <% if @happy_hour.notes.present? %>
        <p class="text-sm text-gray-600 mt-2"><%= @happy_hour.notes %></p>
      <% end %>
      <% if @happy_hour.link.present? %>
        <%= link_to "Source ↗", @happy_hour.link, target: "_blank", rel: "noopener",
              class: "text-sm text-amber-600 hover:underline" %>
      <% end %>
    </div>

    <div class="flex flex-col gap-2 flex-shrink-0">
      <%= link_to "Edit details", edit_admin_happy_hour_path(@happy_hour),
            class: "px-3 py-1.5 bg-gray-100 text-gray-700 text-sm rounded hover:bg-gray-200 text-center" %>
      <% unless @happy_hour.approved? %>
        <%= button_to "Approve", approve_admin_happy_hour_path(@happy_hour), method: :patch,
              class: "px-3 py-1.5 bg-green-600 text-white text-sm rounded hover:bg-green-700" %>
      <% end %>
      <%= button_to "Delete", admin_happy_hour_path(@happy_hour), method: :delete,
            form: { data: { turbo_confirm: "Delete this happy hour?" } },
            class: "px-3 py-1.5 bg-red-100 text-red-700 text-sm rounded hover:bg-red-200" %>
    </div>
  </div>
</div>

<%# Deals — the menu, entered once for all of this happy hour's days %>
<div class="bg-white rounded-lg shadow p-6 mb-6">
  <h2 class="text-lg font-semibold mb-1">Menu / Deals</h2>
  <p class="text-sm text-gray-400 mb-4">These deals apply on every day scheduled below.</p>

  <div id="happy_hour_<%= @happy_hour.id %>_deals" class="space-y-1.5 mb-4">
    <% @happy_hour.deals.each do |deal| %>
      <%= render "admin/deals/deal", deal: deal, happy_hour: @happy_hour %>
    <% end %>
  </div>

  <div data-controller="deal-picker" class="border-t border-gray-100 pt-4">
    <div class="flex gap-2 mb-3">
      <% [ %w[Discount generic], %w[Item item], %w[BOGO bogo] ].each do |label, type| %>
        <button type="button"
                data-action="deal-picker#show"
                data-deal-picker-type-param="<%= type %>"
                data-deal-picker-target="tab"
                class="px-3 py-1 rounded text-sm bg-gray-100 text-gray-600 hover:bg-gray-200">
          + <%= label %>
        </button>
      <% end %>
    </div>

    <div data-deal-picker-target="form" data-type="generic" class="hidden">
      <%= render "admin/deals/generic_form", deal: @happy_hour.happy_hour_generics.new, happy_hour: @happy_hour %>
    </div>
    <div data-deal-picker-target="form" data-type="item" class="hidden">
      <%= render "admin/deals/item_form", deal: @happy_hour.happy_hour_items.new, happy_hour: @happy_hour %>
    </div>
    <div data-deal-picker-target="form" data-type="bogo" class="hidden">
      <%= render "admin/deals/bogo_form", deal: @happy_hour.happy_hour_bogos.new, happy_hour: @happy_hour %>
    </div>
  </div>
</div>

<%# Schedule — which days / hours this menu runs %>
<div class="bg-white rounded-lg shadow p-6">
  <h2 class="text-lg font-semibold mb-4">Schedule</h2>

  <div id="happy_hour_<%= @happy_hour.id %>_days" class="space-y-2 mb-4">
    <% @happy_hour.happy_hour_days.order(:day_of_week).each do |day| %>
      <%= render "admin/happy_hours/day", day: day %>
    <% end %>
  </div>

  <div class="border-t border-gray-100 pt-4 space-y-5">
    <div>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Quick add — same time on several days</p>
      <%= render "admin/happy_hours/bulk_day_form", happy_hour: @happy_hour, day: @happy_hour.happy_hour_days.new %>
    </div>
    <div>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Add a single day</p>
      <%= render "admin/happy_hours/day_form", happy_hour: @happy_hour, day: @happy_hour.happy_hour_days.new %>
    </div>
  </div>
</div>
