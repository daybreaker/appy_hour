<%# locals: happy_hour, url, method %>
<%= form_with model: happy_hour, url: url, method: method, class: "space-y-6" do |f| %>

  <% if happy_hour.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% happy_hour.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <% if happy_hour.new_record? %>
    <div data-controller="venue-search" data-venue-search-url-value="<%= search_admin_venues_path %>" class="relative">
      <label class="block text-sm font-medium text-gray-700 mb-1">Venue</label>
      <%= f.hidden_field :venue_id, data: { venue_search_target: "venueId" } %>
      <input type="text"
             data-venue-search-target="query"
             data-action="input->venue-search#search focusout->venue-search#dismiss"
             value="<%= happy_hour.venue&.name %>"
             placeholder="Search venues by name…"
             autocomplete="off"
             class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
      <div data-venue-search-target="results" class="absolute left-0 right-0 mt-1 z-10"></div>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
    <%= f.text_area :notes, rows: 2, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">
      Link to menu <span class="font-normal text-gray-400">(optional)</span>
    </label>
    <%= f.url_field :source_url, placeholder: "https://…", class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>

  <% if happy_hour.new_record? %>
    <p class="text-sm text-gray-400">You'll add the schedule (days &amp; times) and the deals on the next screen.</p>
  <% end %>

  <div class="flex gap-3">
    <%= f.submit(happy_hour.new_record? ? "Create & add schedule" : "Save",
          class: "px-5 py-2.5 bg-amber-500 text-white rounded-lg hover:bg-amber-600 cursor-pointer") %>
    <%= link_to "Cancel", (happy_hour.persisted? ? admin_happy_hour_path(happy_hour) : admin_happy_hours_path),
          class: "px-5 py-2.5 text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
