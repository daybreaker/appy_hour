<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Unresolved Reports</h1>
  <span class="text-sm text-gray-500"><%= @pagy.count %> reports</span>
</div>

<% if @reports.empty? %>
  <div class="bg-white rounded-lg shadow p-12 text-center text-gray-400">
    <p class="text-lg">No unresolved reports.</p>
  </div>
<% else %>
  <div class="space-y-4">
    <% @reports.each do |report| %>
      <div id="<%= dom_id(report) %>" class="bg-white rounded-lg shadow p-5 flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs text-gray-400">
              Reported by <%= report.user.email %> · <%= time_ago_in_words(report.created_at) %> ago
            </span>
          </div>
          <p class="font-medium text-gray-800 text-sm"><%= report.reason %></p>
          <% if report.notes.present? %>
            <p class="text-sm text-gray-500 mt-1"><%= report.notes %></p>
          <% end %>
          <% if report.reportable.present? %>
            <p class="text-xs text-gray-400 mt-1">
              Subject: <%= report.reportable_type %> #<%= report.reportable_id %>
            </p>
          <% end %>
        </div>
        <div>
          <%= button_to "Resolve", admin_report_path(report),
                method: :patch,
                class: "px-3 py-1.5 bg-gray-700 text-white text-sm rounded hover:bg-gray-900" %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="mt-6 pagy"><%== @pagy.series_nav %></div>
<% end %>
