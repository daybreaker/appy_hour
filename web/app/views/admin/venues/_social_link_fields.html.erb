<%# locals: f (fields_for builder) %>
<div class="flex items-center gap-2" data-nested-form-target="row"
     data-controller="social-link"
     data-social-link-prefixes-value="<%= SocialLink::DISPLAY_PREFIXES.to_json %>">
  <%= f.select :platform, SocialLink.platforms.keys.map { |k| [ SocialLink.new(platform: k).platform_label, k ] },
        {}, data: { social_link_target: "platform", action: "social-link#update" },
        class: "border border-gray-300 rounded px-3 py-2 text-sm" %>

  <div class="flex-1 flex items-center border border-gray-300 rounded overflow-hidden focus-within:ring-2 focus-within:ring-amber-400">
    <span class="pl-2 pr-1 py-2 text-sm text-gray-400 bg-gray-50 whitespace-nowrap"
          data-social-link-target="prefix"><%= SocialLink.display_prefix(f.object.platform) %></span>
    <%= f.text_field :handle, value: f.object.handle, placeholder: "username",
          class: "flex-1 px-1 py-2 text-sm outline-none" %>
  </div>

  <%= f.hidden_field :_destroy, data: { nested_form_target: "destroyFlag" } %>
  <button type="button" data-action="nested-form#remove"
          class="px-2 py-2 text-sm text-red-500 hover:text-red-700">Remove</button>
</div>
