<%# locals: venue, url, method %>
<%= form_with model: venue, url: url, method: method, data: { controller: "nested-form" }, class: "space-y-4" do |f| %>
  <% if venue.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% venue.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
    <%= f.text_field :address, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
      <%= f.text_field :city, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
      <%= f.text_field :state, placeholder: "OH", maxlength: 2,
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm uppercase" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">ZIP</label>
      <%= f.text_field :zip_code, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
      <%= f.telephone_field :phone, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Neighborhood</label>
      <%= f.collection_select :neighborhood_id, Neighborhood.ordered, :id, :name,
            { include_blank: "—" }, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Website</label>
    <%= f.url_field :website_url, placeholder: "https://…", class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Latitude <span class="text-gray-400 font-normal">(optional)</span></label>
      <%= number_field_tag "venue[latitude]", venue.latitude, step: :any,
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Longitude <span class="text-gray-400 font-normal">(optional)</span></label>
      <%= number_field_tag "venue[longitude]", venue.longitude, step: :any,
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
  </div>
  <p class="text-xs text-gray-400 -mt-2">Coordinates power the map and radius search. Leave blank if unknown.</p>

  <div class="border-t border-gray-100 pt-4">
    <label class="block text-sm font-medium text-gray-700 mb-2">Social Media</label>
    <div class="space-y-2" data-nested-form-target="rows">
      <%= f.fields_for :social_links do |social_fields| %>
        <%= render "admin/venues/social_link_fields", f: social_fields %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :social_links, SocialLink.new, child_index: "NEW_RECORD" do |social_fields| %>
        <%= render "admin/venues/social_link_fields", f: social_fields %>
      <% end %>
    </template>

    <button type="button" data-action="nested-form#add"
            class="mt-2 text-sm text-amber-600 hover:text-amber-700 font-medium">+ Add social link</button>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "px-5 py-2.5 bg-amber-500 text-white rounded-lg hover:bg-amber-600 cursor-pointer" %>
    <%= link_to "Cancel", (venue.persisted? ? admin_venue_path(venue) : admin_venues_path),
          class: "px-5 py-2.5 text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
