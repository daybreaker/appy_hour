<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Venues Needing Investigation</h1>
  <span class="text-sm text-gray-500"><%= @pagy.count %> venues</span>
</div>

<% if @venues.empty? %>
  <div class="bg-white rounded-lg shadow p-12 text-center text-gray-400">
    <p class="text-lg">No venues flagged for investigation.</p>
  </div>
<% else %>
  <div class="space-y-4">
    <% @venues.each do |venue| %>
      <div id="<%= dom_id(venue) %>" class="bg-white rounded-lg shadow p-5 flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-gray-900"><%= venue.name %></h3>
          <p class="text-sm text-gray-500"><%= venue.address %>, <%= venue.city %> <%= venue.zip_code %></p>
          <% if venue.website_url.present? %>
            <%= link_to venue.website_url, venue.website_url, target: "_blank", rel: "noopener",
                  class: "text-sm text-blue-600 hover:underline" %>
          <% end %>
          <% last_run = venue.scraper_runs.order(run_at: :desc).first %>
          <% if last_run %>
            <p class="text-xs text-gray-400 mt-1">
              Last scraped <%= time_ago_in_words(last_run.run_at) %> ago —
              <span class="<%= last_run.parse_failed? || last_run.fetch_failed? ? "text-red-500" : "text-gray-400" %>">
                <%= last_run.result.humanize %>
              </span>
            </p>
          <% else %>
            <p class="text-xs text-gray-400 mt-1">Never scraped</p>
          <% end %>

          <% if venue.social_links.any? %>
            <div class="flex flex-wrap gap-2 mt-2">
              <% venue.social_links.each do |social| %>
                <%= link_to social.platform_label, social.url, target: "_blank", rel: "noopener",
                      class: "inline-flex items-center text-xs px-2 py-0.5 rounded bg-gray-100 text-gray-700 hover:bg-gray-200" %>
              <% end %>
            </div>
          <% end %>
        </div>
        <div>
          <%= button_to "Mark Reviewed", admin_venue_path(venue),
                method: :patch,
                params: { clear_investigation: "1" },
                class: "px-3 py-1.5 bg-green-600 text-white text-sm rounded hover:bg-green-700" %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="mt-6 pagy"><%== @pagy.series_nav %></div>
<% end %>
