<h1 class="text-2xl font-bold mb-8">Dashboard</h1>

<div class="grid grid-cols-2 gap-6 lg:grid-cols-4">
  <%= link_to admin_happy_hours_path do %>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-3xl font-bold text-amber-600"><%= @pending_happy_hours_count %></p>
      <p class="text-sm text-gray-500 mt-1">Happy Hours Awaiting Approval</p>
    </div>
  <% end %>

  <%= link_to admin_venues_path(filter: "investigation") do %>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-3xl font-bold text-orange-600"><%= @needs_investigation_count %></p>
      <p class="text-sm text-gray-500 mt-1">Venues Need Investigation</p>
    </div>
  <% end %>

  <%= link_to admin_comments_path do %>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-3xl font-bold text-blue-600"><%= @pending_comments_count %></p>
      <p class="text-sm text-gray-500 mt-1">Comments Pending Review</p>
    </div>
  <% end %>

  <%= link_to admin_reports_path do %>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-3xl font-bold text-red-600"><%= @unresolved_reports_count %></p>
      <p class="text-sm text-gray-500 mt-1">Unresolved Reports</p>
    </div>
  <% end %>
</div>
