<%# locals: neighborhood, url, method %>
<%= form_with model: neighborhood, url: url, method: method, class: "space-y-4" do |f| %>
  <% if neighborhood.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% neighborhood.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
    <%= f.text_field :name, placeholder: "e.g. Ohio City",
          class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div class="col-span-2">
      <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
      <%= f.text_field :city, placeholder: "e.g. Cleveland",
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
      <%= f.text_field :state, placeholder: "OH", maxlength: 2,
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm uppercase" %>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">
      Slug <span class="font-normal text-gray-400">(optional)</span>
    </label>
    <%= f.text_field :slug, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    <p class="text-xs text-gray-400 mt-1">Leave blank to auto-generate from city + name. Lowercase letters, numbers, and hyphens only.</p>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "px-5 py-2.5 bg-amber-500 text-white rounded-lg hover:bg-amber-600 cursor-pointer" %>
    <%= link_to "Cancel", admin_neighborhoods_path, class: "px-5 py-2.5 text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
