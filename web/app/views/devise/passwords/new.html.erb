<div class="max-w-md mx-auto mt-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
    <h1 class="text-2xl font-bold text-center mb-1">Forgot your password?</h1>
    <p class="text-center text-gray-500 text-sm mb-6">We'll email you reset instructions</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-400 focus:border-amber-400 outline-none" %>
      </div>

      <%= f.submit "Send reset instructions",
            class: "w-full bg-amber-500 text-white font-medium rounded-lg px-4 py-2.5 hover:bg-amber-600 cursor-pointer transition" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
