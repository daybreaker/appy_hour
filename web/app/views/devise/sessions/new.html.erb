<div class="max-w-md mx-auto mt-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
    <h1 class="text-2xl font-bold text-center mb-1">Welcome back</h1>
    <p class="text-center text-gray-500 text-sm mb-6">Log in to your AppyHour account</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-400 focus:border-amber-400 outline-none" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-400 focus:border-amber-400 outline-none" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-gray-600">
          <%= f.check_box :remember_me, class: "rounded border-gray-300 text-amber-500 focus:ring-amber-400" %>
          Remember me
        </label>
      <% end %>

      <%= f.submit "Log in",
            class: "w-full bg-amber-500 text-white font-medium rounded-lg px-4 py-2.5 hover:bg-amber-600 cursor-pointer transition" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
